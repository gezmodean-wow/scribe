# Discord
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# Comma-separated Discord role IDs allowed to use SCRIBE's slash commands.
# Enable Developer Mode (Settings → Advanced), right-click each role in
# Server Settings → Roles → Copy ID.
# Example: DISCORD_STAFF_ROLE_IDS=111111111111111111,222222222222222222,333333333333333333
DISCORD_STAFF_ROLE_IDS=

# GitHub App
# Private key is a multi-line PEM. In .env, wrap in double quotes to preserve newlines:
#   GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
#   MIIEow...
#   -----END RSA PRIVATE KEY-----"
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Database (local default matches docker-compose.yml)
DATABASE_URL=postgres://scribe:scribe@localhost:5432/scribe

# HTTP
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# Logging
LOG_LEVEL=info
NODE_ENV=development
